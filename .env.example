# ==============================================================================
# ZSMS — Environment Configuration Specification Template (Stage 3.5)
# Brand: ZTechAI
# Copy this file to .env and configure your local or production values.
# NEVER commit .env to version control!
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION SETTINGS (Required Local & Production)
# ==============================================================================
APP_NAME=ZSMS
APP_ENV=development                       # development | staging | production
APP_DEBUG=true
LOG_LEVEL=info                            # debug | info | warn | error
TZ=UTC

# ==============================================================================
# 2. APPLICATION & SERVICE URLS
# Production:
# APP_URL=https://sms.ztechai.us
# API_URL=https://sms-api.ztechai.us
# WEB_URL=https://sms.ztechai.us
# NUXT_PUBLIC_API_BASE_URL=https://sms-api.ztechai.us
# ==============================================================================
APP_URL=http://localhost:3000             # Nuxt 3 Web Application URL (Prod: https://sms.ztechai.us)
API_URL=http://localhost:8080             # Go Fiber Backend API URL (Prod: https://sms-api.ztechai.us)
WEB_URL=http://localhost:3000             # Legacy / alternate web URL alias
DOCS_URL=http://localhost:8080/docs       # Swagger / OpenAPI documentation endpoint
NUXT_PUBLIC_API_BASE_URL=https://sms-api.ztechai.us

# ==============================================================================
# 3. HTTP SERVER & CORS BINDING
# ==============================================================================
PORT=8080                                 # Backend API port
HOST=0.0.0.0                              # Bind to all interfaces for physical phone LAN access
ALLOW_HTTP_LOCAL=false                    # Set false for production, true for local LAN testing
CORS_ALLOW_ORIGINS=https://sms.ztechai.us
CORS_ALLOWED_ORIGINS=https://sms.ztechai.us,http://localhost:3000

# ==============================================================================
# 4. POSTGRESQL DATABASE
# ==============================================================================
# DATABASE_URL is authoritative if provided:
# DATABASE_URL=postgres://zsms_user:your_password@postgres:5432/zsms_db?sslmode=disable
# Fallback individual parameters (both POSTGRES_* and DB_* supported):
POSTGRES_DB=zsms_db
POSTGRES_USER=zsms_user
POSTGRES_PASSWORD=zsms_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DB_NAME=zsms_db
DB_USER=zsms_user
DB_PASSWORD=zsms_dev_password
DATABASE_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# ==============================================================================
# 5. REDIS BROKER & CACHE (Required Local & Production)
# ==============================================================================
# Either provide REDIS_URL directly, or define individual REDIS_* values:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_RETRIES=3

# ==============================================================================
# 6. AUTHENTICATION & DEVICE PAIRING (Required Local & Production)
# ==============================================================================
# Set AUTH_DISABLED=true to temporarily bypass web login during development/testing.
# Default is false (secure production enforcement). Device auth is always enforced.
AUTH_DISABLED=false
JWT_SECRET=dev_jwt_secret_do_not_use_in_production_min_64_bytes_required_random_string
JWT_EXPIRATION=72h                         # JWT lifetime string (e.g. 72h, 24h)
JWT_EXPIRATION_HOURS=72                    # Numeric JWT lifetime in hours
PAIRING_CODE_EXPIRATION=10                 # Pairing PIN validity window in minutes (default: 10)
DEVICE_TOKEN_PREFIX=zsms_dev_              # Prefix for Android hardware API tokens

# ==============================================================================
# 7. LOCAL STORAGE (Required Local & Production)
# ==============================================================================
STORAGE_DRIVER=minio                       # minio | local | r2
STORAGE_PATH=./storage                     # Local storage directory fallback

# MinIO Local S3 Settings (Default for local development)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=zsms_minio_admin
S3_SECRET_KEY=zsms_minio_secret_key
S3_BUCKET=zsms-media
S3_REGION=us-east-1
S3_USE_SSL=false

# ==============================================================================
# 8. OPERATIONAL LIMITS & THRESHOLDS
# ==============================================================================
PHONE_OFFLINE_THRESHOLD_SECONDS=120        # Time after which phone is marked offline
DEFAULT_MESSAGE_EXPIRY_HOURS=24
MAX_BULK_BATCH_SIZE=1000

# ==============================================================================
# 9. FUTURE-STAGE CREDENTIALS (OPTIONAL / NOT REQUIRED FOR LOCAL SMS GATEWAY TEST)
# ==============================================================================
# The following services are NOT required for Stage 3 / 3.5 local physical SMS testing.
# Leave blank or unconfigured during local verification.

# Firebase Cloud Messaging (FCM v1) — Reserved for Stage 6
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 MMS Storage — Reserved for Stage 9
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# SMTP Email Relay — Reserved for Stage 10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sms.ztechai.us
SMTP_FROM_NAME="ZTechAI ZSMS"
SMTP_TLS=true

# Cloudflare Turnstile Bot Protection — Reserved for Stage 11
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application Encryption Key — Reserved for Stage 5+
ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=dev_webhook_signing_secret
