<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSettingsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gateway Settings"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSettingsDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure the ZSMS Server API endpoint (e.g. https://sms-api.ztechai.us for Production/Staging, or http://192.168.1.100:8080 for local LAN)."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsHeader" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Server URL"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsDesc">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTestPing"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Test Server Connection"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/tilServerUrl" />

    <TextView
        android:id="@+id/tvPingResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnTestPing" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Save Configuration"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/tvPingResult" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnpair"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Unpair Device"
        style="@style/Widget.Material3.Button.TextButton"
        android:textColor="#FF5630"
        app:layout_constraintTop_toBottomOf="@id/btnSaveSettings" />

</androidx.constraintlayout.widget.ConstraintLayout>
